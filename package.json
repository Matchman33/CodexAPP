{
  "name": "codexapp-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Relay + PWA to remote-control a local Codex app-server from an iPhone.",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "npc:install": "powershell -NoProfile -ExecutionPolicy Bypass -File ./install.ps1 npc latest .",
    "prepare:terminal": "node scripts/prepare-terminal.mjs",
    "prestart": "npm run prepare:terminal && npm run build:web",
    "prestart:agent": "npm run prepare:terminal",
    "test": "node --test tests/*.test.mjs",
    "test:web": "npm run build:web && node tests/web-ui.integration.mjs",
    "test:history-web": "npm run build:web && node tests/history-web.integration.mjs",
    "test:queue-web": "npm run build:web && node tests/queue-web.integration.mjs",
    "test:stream-web": "npm run build:web && node tests/streaming-web.integration.mjs",
    "test:order-web": "npm run build:web && node tests/messageOrder-web.integration.mjs",
    "test:reasoning-web": "npm run build:web && node tests/reasoning-web.integration.mjs",
    "test:permissions-web": "npm run build:web && node tests/permissions-web.integration.mjs",
    "test:sessions-web": "npm run build:web && node tests/sessions-web.integration.mjs",
    "test:restart-process": "node tests/serviceRestart.integration.mjs",
    "test:watch-rpc": "node tests/sessionWatch.rpc.integration.mjs",
    "test:terminal-web": "npm run build:web && node tests/terminal-web.integration.mjs",
    "test:terminal-navigation": "npm run build:web && node tests/terminal-navigation-web.integration.mjs",
    "test:terminal-process": "node tests/terminal-process.integration.mjs",
    "test:images-web": "npm run build:web && node tests/images-web.integration.mjs",
    "test:files-web": "npm run build:web && node tests/files-web.integration.mjs",
    "test:links-web": "npm run build:web && node tests/links-web.integration.mjs",
    "test:file-changes-web": "npm run build:web && node tests/fileChanges-web.integration.mjs",
    "test:lifecycle-web": "npm run build:web && node tests/threadLifecycle-web.integration.mjs",
    "test:writer-web": "npm run build:web && node tests/writerOnOpen-web.integration.mjs",
    "test:writer-process": "node tests/writerControl.windows.integration.mjs",
    "test:sleep-process": "node tests/sleepPrevention.windows.integration.mjs",
    "start": "node scripts/run.mjs relay",
    "start:agent": "node scripts/run.mjs agent",
    "probe": "node relay/probe.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.15",
    "lucide": "^1.45.0",
    "marked": "^18.0.12",
    "node-pty": "^1.1.0",
    "nodemailer": "^9.0.1",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.1",
    "postject": "^1.0.0-alpha.6"
  }
}
